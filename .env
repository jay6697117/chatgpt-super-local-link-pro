# ============================================================
# ChatGPT Super Local Link Pro
# Node.js / TypeScript Remote MCP Server
# ============================================================
# 修改后需要重启服务。
# Windows 多目录用英文分号 ; 分隔。例：D:/work/A;D:/work/B
# macOS/Linux 多目录同样用 ; 分隔。例：/Users/me/work/A;/Users/me/work/B

# -------------------- 基础服务配置 --------------------
NODE_ENV=development
APP_NAME=ChatGPT Super Local Link Pro
PORT=2091
HOST=127.0.0.1
TRUST_PROXY=1
LOG_LEVEL=info
LOG_DIR=./logs

# ChatGPT 连接器一般填写：https://你的域名/mcp
MCP_PATH=/mcp
# 旧客户端兼容入口；ChatGPT 新连接优先用 /mcp
ENABLE_LEGACY_SSE=1
SSE_PATH=/sse
SSE_MESSAGES_PATH=/messages

# 推荐：0。OpenAI Apps SDK quickstart 的本地连接示例使用 stateless Streamable HTTP。
# 需要长会话 SSE/GET 能力时再改成 1。
MCP_STATEFUL_SESSIONS=0
MCP_ENABLE_JSON_RESPONSE=1

# -------------------- 认证配置 --------------------
# ChatGPT Developer Mode 的 No Authentication 连接器请保持 no-auth。
# 自己的客户端需要简单保护时，可改 bearer 并设置 AUTH_TOKEN。
AUTH_MODE=no-auth
AUTH_TOKEN=

# CORS。开发期可以 *；生产公网建议改成明确来源。
CORS_ALLOWED_ORIGINS=*

# 简单速率限制。0 表示关闭。
HTTP_RATE_LIMIT_WINDOW_MS=60000
HTTP_RATE_LIMIT_MAX=240

# -------------------- 本地项目白名单 --------------------
# 默认只开放本项目自带 workspace。把这里改成你的项目目录。
# 例：ROOTS=D:/work/JiaDianAI;D:/mcp-work/harmonyos-libretro-emulator
ROOTS=/Users/zhangjinhui/Desktop

# 路径输入可以是绝对路径，也可以是相对 ROOTS[0] 的路径。
ALLOW_RELATIVE_PATHS=1

# -------------------- 读取限制 --------------------
MAX_READ_BYTES=262144
MAX_READ_MANY_FILES=20
MAX_READ_MANY_TOTAL_BYTES=1048576
MAX_SEARCH_FILE_BYTES=524288
MAX_SEARCH_FILES=2500
MAX_SEARCH_RESULTS=200
MAX_SEARCH_RESULT_LINE_CHARS=260
DEFAULT_TREE_DEPTH=3
MAX_TREE_DEPTH=8
MAX_TREE_ENTRIES=2500
MAX_PROJECT_OVERVIEW_FILES=80

# -------------------- 写入限制 --------------------
# 默认强烈建议只读。确认无误后再开启写入。
ALLOW_WRITE=1
# 修改/覆盖已有文件必须同时开启 ALLOW_WRITE=1 和 ALLOW_OVERWRITE=1。
ALLOW_OVERWRITE=1
# true 时写操作只演练，不落盘。初次开启写入建议设为 1 先测试。
DRY_RUN_WRITE=0
BACKUP_BEFORE_OVERWRITE=1
BACKUP_DIR=.super-local-link-backups
MAX_WRITE_BYTES=524288
MAX_REPLACE_OCCURRENCES=50

# -------------------- 安全排除策略 --------------------
# DEFAULT_EXCLUDE_PATTERNS 是硬性默认排除，建议不要删除敏感项。
DEFAULT_EXCLUDE_PATTERNS=**/.git/**;**/.svn/**;**/.hg/**;**/node_modules/**;**/dist/**;**/build/**;**/.next/**;**/.nuxt/**;**/.turbo/**;**/coverage/**;**/.cache/**;**/tmp/**;**/temp/**;**/.env;**/.env.*;**/*secret*;**/*secrets*;**/*credential*;**/*credentials*;**/*token*;**/*.pem;**/*.key;**/*.p12;**/*.pfx;**/id_rsa;**/id_ed25519;**/.ssh/**;**/.aws/**;**/.azure/**;**/.gcloud/**;**/*.sqlite;**/*.sqlite3;**/*.db;**/*.mdb;**/*.bak;**/*.dump

# 你自己的额外排除项。例：EXTRA_EXCLUDE_PATTERNS=**/private/**;**/vendor/**
EXTRA_EXCLUDE_PATTERNS=

# 文件扩展名黑名单，英文逗号分隔。
BLOCKED_EXTENSIONS=.png,.jpg,.jpeg,.gif,.webp,.ico,.pdf,.zip,.rar,.7z,.tar,.gz,.bz2,.xz,.mp4,.mov,.avi,.mkv,.mp3,.wav,.flac,.exe,.dll,.so,.dylib,.class,.jar,.war,.bin,.dat,.sqlite,.sqlite3,.db,.pem,.key,.p12,.pfx

# -------------------- 调试端点 --------------------
# 开启后可访问 /debug/config 查看脱敏配置。
ENABLE_DEBUG_ENDPOINTS=1
